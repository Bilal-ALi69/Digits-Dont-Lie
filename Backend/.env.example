# Groq API key for AI-powered analysis
# Get yours at: https://console.groq.com
GROQ_API_KEY=

# API key for authenticating requests (required).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Comma-separated list of CORS origins allowed to call this API.
# Leave empty to deny all cross-origin requests (safest for non-browser clients).
# Example: ALLOWED_ORIGINS=https://yourapp.com,https://admin.yourapp.com
ALLOWED_ORIGINS=

# Security posture. The default when UNSET is the hardened one: the API key is
# enforced, and /docs, /redoc and /openapi.json are all closed. This defaults to
# safe on purpose, so that forgetting to configure a deployment cannot silently
# leave it wide open.
#
# Set to "development" ONLY for local work. That disables authentication
# entirely and publishes the API schema.
# ENVIRONMENT=development

# Requests per minute per client address, counted within this process.
# Uploads get a separate, smaller budget: each one costs seconds of CPU across
# several OCR passes, so it cannot share an allowance with endpoints that only
# parse a string. Behind multiple workers each keeps its own tally, so the real
# limit multiplies by worker count — enforce at the reverse proxy instead there.
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_UPLOADS_PER_MINUTE=12

# Optional: max seconds a single request may take before a timeout header is added (default: 120)
# REQUEST_TIMEOUT=120

# Optional: override the text model used for explanations.
# The default is llama-3.1-8b-instant — chosen for latency, since an
# explanation is written on the request path. The line below is an example of
# a larger alternative, not the default.
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: override the multimodal model used to identify uploaded documents
# from the image itself. Must be image-capable — as of writing, qwen3.6 is the
# only such model Groq serves (the llama-3.2-*-vision models were decommissioned
# and no llama-4 multimodal model is exposed).
# GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Optional: timeout in seconds for vision calls (default: 45). Deliberately far
# higher than GROQ_TIMEOUT — the model reasons over the image first, and
# measured round trips ranged from ~3s to ~28s.
# GROQ_VISION_TIMEOUT=45

# Optional: override temperature (default: 0.3)
# GROQ_TEMPERATURE=0.3

# Optional: override max tokens (default: 512)
# GROQ_MAX_TOKENS=512

# Optional: override API timeout in seconds (default: 8)
# GROQ_TIMEOUT=8
