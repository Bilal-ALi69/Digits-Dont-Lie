# Backend API configuration — server-only (no NEXT_PUBLIC_ prefix). These are
# read by app/api/*/route.ts, which proxy browser requests to the FastAPI
# backend and attach the key server-side, so it never reaches client JS.

# URL of the FastAPI backend.
BACKEND_URL=http://127.0.0.1:8000

# Must match the backend's API_KEY (Backend/.env). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=
